{
  "name": "pi-orchestrator",
  "version": "0.2.0",
  "private": true,
  "description": "A project-local control plane for isolated, model-routed Pi sessions.",
  "type": "module",
  "bin": {
    "orchestrator": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "sandbox"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example:create": "npm run build --silent && node dist/cli.js example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "minimatch": "^10.2.3",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  }
}
